{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Night", "slug": "night", "color": "#08041a" },
				{ "name": "Deep Violet", "slug": "deep-violet", "color": "#0e0826" },
				{ "name": "Neon Magenta", "slug": "magenta", "color": "#ff3ecf" },
				{ "name": "UV Violet", "slug": "uv-violet", "color": "#8a5cff" },
				{ "name": "Cyan", "slug": "cyan", "color": "#37f5e0" },
				{ "name": "Acid", "slug": "acid", "color": "#b8ff2e" },
				{ "name": "Amber", "slug": "amber", "color": "#ffb32e" },
				{ "name": "Moth", "slug": "moth", "color": "#f0e9ff" },
				{ "name": "Moth Dim", "slug": "moth-dim", "color": "#a99cc9" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Sora (Body)",
					"slug": "body",
					"fontFamily": "'Sora', 'Avenir Next', 'Segoe UI', sans-serif"
				},
				{
					"name": "Space Mono (Labels)",
					"slug": "mono",
					"fontFamily": "'Space Mono', 'Courier New', monospace"
				},
				{
					"name": "Monoton (Neon Display)",
					"slug": "display",
					"fontFamily": "'Monoton', 'Arial Black', sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Body", "slug": "small", "size": "clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem)" },
				{ "name": "Lead", "slug": "medium", "size": "clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem)" },
				{ "name": "Statement", "slug": "large", "size": "clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem)" },
				{ "name": "Title", "slug": "x-large", "size": "clamp(2.2rem, 1.6rem + 3vw, 4rem)" }
			]
		},
		"layout": {
			"contentSize": "62ch",
			"wideSize": "72rem"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--night)",
			"text": "var(--wp--preset--color--moth)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--small)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--cyan)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
